# ─── Supabase ────────────────────────────────────────────────────────────────
# Local: run `npx supabase status` after `npx supabase start` and copy the values.
# Hosted: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used for OAuth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── OpenStreetMap services ─────────────────────────────────────────────────
# Sent in the User-Agent of every Photon/Nominatim/Overpass request, as their
# usage policies require. Use a real address you read.
OSM_CONTACT_EMAIL=you@example.com
# Optional overrides (e.g. a self-hosted Photon). Defaults are the public instances.
# PHOTON_URL=https://photon.komoot.io
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ─── Development only ───────────────────────────────────────────────────────
# Shows "Sign in as demo user" buttons on /login. Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN=true
# Password given to the seeded demo users.
DEMO_USER_PASSWORD=palater-demo
